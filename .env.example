# ReleaseGuard environment configuration (example). Copy to .env and adjust.
# Never commit real secrets.

# Database (default: file-backed SQLite in the working directory)
DATABASE_URL=sqlite:///./releaseguard.db

# Deployment mode; "production" enforces stricter auth configuration checks
RELEASEGUARD_ENV=development

# Enable local multi-user authentication (sessions + RBAC) on /api and UI
RELEASEGUARD_REQUIRE_USER_AUTH=false

# Optional shared API token; when set, /api requires X-ReleaseGuard-Token
RELEASEGUARD_WRITE_TOKEN=

# Secret used for UI CSRF tokens (set a long random value when auth is enabled)
RELEASEGUARD_CSRF_SECRET=

# Password for the first owner; read only by scripts/create_owner.py
RELEASEGUARD_OWNER_PASSWORD=
